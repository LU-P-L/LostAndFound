<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 添加顶部返回按钮 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/toolbar">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="我的失物"
                android:textColor="@color/text_secondary"
                android:textStyle="bold"
                android:textSize="18sp" />
        </RelativeLayout>

        <!-- 常见问题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="常见问题"
            android:textSize="18sp"
            android:paddingTop="16dp"
            android:textStyle="bold"/>

        <!-- 问题1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="如何发布失物信息？"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 点击底部导航栏的发布按钮\n2. 选择失物发布类型\n3. 填写物品信息并上传照片\n4. 点击提交完成发布"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- 问题2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="如何修改个人信息？"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 进入个人页面\n2. 点击个人信息卡片\n3. 修改您的资料\n4. 点击保存完成修改"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- 问题3 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="如何联系拾获者？"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. 在物品详情页面点击联系TA按钮\n2. 系统将向对方发送联系请求\n3. 对方同意后可通过应用内聊天沟通"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E7E4E4"
            android:layout_marginTop="16dp"/>

        <!-- 客服支持 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="客服支持"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工作时间：9:00-18:00（周一至周五）"
            android:textSize="16sp"
            android:layout_marginTop="10dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="客服电话：400-123-4567"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="客服邮箱：support@lostandfound.com"
            android:textSize="16sp"
            android:layout_marginTop="8dp"/>

        <!-- 反馈按钮 -->
        <Button
            android:id="@+id/btn_feedback"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="意见反馈"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</ScrollView>