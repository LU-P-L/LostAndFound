<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- 圆角设置 -->
    <corners android:radius="4dp" />

    <!-- 绿色背景，表示已找回 -->
    <solid android:color="#4CAF50" />

    <!-- 边框设置 -->
    <stroke
        android:width="1dp"
        android:color="#388E3C" />

    <!-- 内边距 -->
    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />
</shape>